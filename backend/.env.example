# Puerto HTTP de la API
PORT=3000

# Nivel de trazas: debug | info | warn | error | silent
#   info  -> una línea por petición + resumen de cada cálculo de ruta
#   debug -> además, detalle de cada itinerario y de la carga del GTFS
LOG_LEVEL=info

# Origen de los datos GTFS estáticos: "local" o "url"
GTFS_SOURCE=local

# Si GTFS_SOURCE=local: carpeta con los .txt o ruta a un .zip
GTFS_LOCAL_PATH=./data/gtfs-sample

# Si GTFS_SOURCE=url: URL que devuelve el zip GTFS
GTFS_URL=

# Cada cuántos minutos se recargan los datos (0 = nunca)
GTFS_REFRESH_MINUTES=1440

# Carpeta donde se descargan/extraen los zips
GTFS_CACHE_DIR=./data/cache

# Zona horaria (opcional, por defecto la de agency.txt)
TIMEZONE=

# Parámetros de cálculo
MAX_WALK_METERS=800
MAX_TRANSFER_METERS=300
MAX_DIRECT_WALK_METERS=2000
WALK_SPEED_MPS=1.25
WALK_DISTANCE_FACTOR=1.25
MIN_TRANSFER_SECONDS=60
MAX_ITINERARIES=3
MAX_SEARCH_HOURS=6

# DEPURACIÓN: true = ignora calendar.txt/calendar_dates.txt y da por activos
# todos los servicios cualquier día (útil con feeds caducados o de un solo día).
# Ojo: pueden aparecer a la vez viajes de laborable y de festivo.
DEBUG_IGNORE_CALENDAR=false

# --- GTFS-Realtime (opcional) ---
# URLs de los feeds en tiempo real (protobuf). Vacías = solo horarios programados.
# Si el proveedor da un único feed con todo, pon la misma URL en las tres: se descarga una vez.
#   TripUpdates      -> retrasos, cancelaciones y paradas suprimidas (afectan al cálculo de rutas)
#   VehiclePositions -> posición de los vehículos en el mapa
#   Alerts           -> avisos de incidencias en los tramos afectados
GTFS_RT_TRIP_UPDATES_URL=
GTFS_RT_VEHICLE_POSITIONS_URL=
GTFS_RT_ALERTS_URL=
# Cada cuántos segundos se descargan (mínimo 5)
GTFS_RT_REFRESH_SECONDS=30
# Minutos sin peticiones a la API tras los que se pausa la descarga (0 = nunca).
# Se reanuda con la siguiente petición, que espera hasta 3 s a tener datos frescos.
GTFS_RT_IDLE_MINUTES=10
# Antigüedad máxima de los datos para usarlos (0 = sin límite): si el proveedor deja
# de actualizar, no se aplican retrasos caducados.
GTFS_RT_MAX_AGE_SECONDS=300
GTFS_RT_TIMEOUT_MS=10000
GTFS_RT_MAX_DOWNLOAD_MB=20
# Cabeceras extra en JSON, p. ej. la clave del proveedor: {"x-api-key":"..."}
GTFS_RT_HEADERS=
# Idioma preferido para los textos de los avisos
GTFS_RT_LANGUAGE=es

# Buscador de direcciones (geocodificación)
# Proveedor: "photon" (por defecto, permite autocompletar) o "nominatim"
GEOCODER_PROVIDER=photon
# URL del servicio (por defecto la pública del proveedor; se puede usar una instancia propia)
GEOCODER_URL=
# Identificación enviada al proveedor (Nominatim la exige; pon un contacto real en producción)
GEOCODER_USER_AGENT=route-calculator/0.1 (desarrollo)
GEOCODER_LANGUAGE=es
# Limitar los resultados a la zona del GTFS (+ margen)
GEOCODER_RESTRICT_TO_GTFS=true
GEOCODER_BOUNDS_MARGIN_METERS=5000
# Intervalo mínimo entre peticiones a Nominatim (su servidor público exige 1 por segundo)
GEOCODER_MIN_INTERVAL_MS=1000

# --- Seguridad ---
# Interfaz de escucha (vacío = todas). En producción detrás de un proxy: 127.0.0.1
HOST=
# Orígenes permitidos por CORS, separados por comas. Vacío = solo mismo origen
# (en desarrollo el frontend usa el proxy de Vite y no lo necesita). "*" = cualquiera.
CORS_ORIGINS=
# Token para POST /api/gtfs/reload ("Authorization: Bearer <token>", mín. 16 caracteres).
# Vacío = endpoint deshabilitado.
ADMIN_TOKEN=
# Límite de peticiones por IP y ventana (0 = sin límite). /api/health no cuenta.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Proxies de confianza para obtener la IP real (X-Forwarded-For): número de saltos o lista de IPs.
# No uses "true" si la API es accesible directamente: cualquiera podría falsear su IP.
TRUST_PROXY=
# Límites de descarga y descompresión del GTFS (protección frente a zips maliciosos)
GTFS_DOWNLOAD_TIMEOUT_MS=120000
GTFS_MAX_DOWNLOAD_MB=200
GTFS_ZIP_MAX_ENTRIES=200
GTFS_ZIP_MAX_FILE_MB=1024
GTFS_ZIP_MAX_TOTAL_MB=2048
