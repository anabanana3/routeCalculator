# URL base de la API (vacío = mismo origen, usando el proxy de Vite en desarrollo)
VITE_API_URL=

# Proveedor de teselas del mapa (OpenStreetMap por defecto)
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Centro inicial del mapa si el backend no devuelve los límites del GTFS
VITE_DEFAULT_LAT=40.4168
VITE_DEFAULT_LON=-3.7038
